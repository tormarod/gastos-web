# Copy this to .env and fill in your values (never commit .env to git)

# A long random string — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

# The shared password for the app (both Rodrigo & Rocío use this)
APP_PASSWORD=cambiame

# AWS credentials (IAM user with access to the bucket only — see DEPLOY.md)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=eu-west-1

# The S3 bucket name you created
S3_BUCKET_NAME=gastos-rodrigo-rocio

# Set to "production" on Render (secure cookies; the app refuses to start without SECRET_KEY/APP_PASSWORD)
ENV=production

# ── Local development ────────────────────────────────────────────────────────
# Keep the data in a local folder instead of S3 (no AWS needed):
# STORAGE_BACKEND=local
# LOCAL_DATA_DIR=.data

# ── Bank connection (optional, see DEPLOY.md → Enable Banking) ───────────────
# Public address of the app. The bank sends you back to PUBLIC_URL/banco/callback
PUBLIC_URL=https://gastos-web.onrender.com
# Application id from the Enable Banking control panel
ENABLE_BANKING_APP_ID=
# Contents of the private key (.pem) downloaded when creating the application.
# Paste it on one line with \n instead of line breaks, or point to the file:
ENABLE_BANKING_PRIVATE_KEY=
# ENABLE_BANKING_PRIVATE_KEY_PATH=/etc/secrets/enablebanking.pem
# Secret shared with the daily cron (GitHub Actions) that calls /api/sync
SYNC_TOKEN=
