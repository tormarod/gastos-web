# Copy this to .env and fill in your values (never commit .env to git)

# A long random string — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

# The shared password for the app (both Rodrigo & Rocío use this)
APP_PASSWORD=cambiame

# AWS credentials (IAM user with S3 access only — create in AWS IAM console)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=eu-west-1

# The S3 bucket name you created
S3_BUCKET_NAME=gastos-rodrigo-rocio

# Set to "production" on Render (enables secure cookies)
ENV=production
